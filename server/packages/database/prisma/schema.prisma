generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. Better Auth Core Authentication Models
// ==========================================

enum UserScope {
  APP_USER // Regular customer signup
  SYSTEM   // GraphMint platform internal staff (SuperAdmin, Support, etc.)
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  userScope     UserScope @default(APP_USER)

  // Platform Staff Role (Active when userScope == SYSTEM)
  systemRoleId String?
  systemRole   Role?   @relation("SystemStaffRole", fields: [systemRoleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Better Auth Core Relations
  sessions Session[]
  accounts Account[]

  // Customer Tenant Relations
  organizationMembers OrganizationMember[]
  projectMembers      ProjectMember[]
  ownedOrganization   Organization?        @relation("OrganizationOwner")
  ownedProjects       Project[]            @relation("ProjectOwner")
  sentInvitations     Invitation[]         @relation("SentInvitations")
  createdDiagrams     Diagram[]            @relation("DiagramCreator")
  createdVersions     SchemaVersion[]
  writtenComments     Comment[]            @relation("CommentAuthor")
  resolvedComments    Comment[]            @relation("CommentResolver")
  assignedComments    Comment[]            @relation("CommentAssignee")
  auditLogs           AuditLog[]

  // Real-Time Chat & Direct Messaging Relations
  createdChatRooms    ChatRoom[]           @relation("ChatRoomCreator")
  chatRoomMemberships ChatRoomMember[]
  sentChatMessages    ChatMessage[]        @relation("SentChatMessages")

  // Action-Oriented AI Agent Relations
  aiSessions          AISession[]
  appliedChangeSets   ChangeSet[]          @relation("ChangeSetApplier")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ==========================================
// 2. Organization Layer (Multi-Tenancy)
// ==========================================

model Organization {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  logo        String?
  description String?
  metadata    String?

  ownerId String? @unique
  owner   User?   @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  members      OrganizationMember[]
  projects     Project[]
  roles        Role[]
  invitations  Invitation[]
  subscription Subscription?
  chatRooms    ChatRoom[]
  auditLogs    AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization")
}

model OrganizationMember {
  slug           String?
  organizationId String
  userId         String
  roleId         String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([organizationId, userId])
  @@map("organization_member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String? // Better Auth role string fallback (e.g. "admin", "member")
  roleId         String? // Custom Role linkage
  customRole     Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  status         String       @default("pending") // pending | accepted | rejected | canceled
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
  @@map("invitation")
}

// ==========================================
// 3. Project Layer (Projects & Graph Containers)
// ==========================================

model Project {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  isDefault Boolean @default(false)

  members    ProjectMember[]
  diagrams   Diagram[]
  roles      Role[]
  chatRooms  ChatRoom[]
  aiSessions AISession[]
  auditLogs  AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@map("project")
}

model ProjectMember {
  projectId String
  userId    String
  roleId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([projectId, userId])
  @@map("project_member")
}

// ==========================================
// 4. Diagram, Canvas & Versioning Engine
// ==========================================

enum DatabaseType {
  POSTGRESQL
  MYSQL
  SQLITE
  MONGODB
  MARIADB
  COCKROACHDB
  SUPABASE
  NEON
  SINGLESTORE
  ORACLE
  SQLSERVER
}

model Diagram {
  id           String       @id @default(cuid())
  name         String
  slug         String
  description  String?
  databaseType DatabaseType @default(POSTGRESQL)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("DiagramCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Canvas Viewport & Layout State (React Flow / xyflow settings)
  canvasData Json? // { zoom: 1, pan: { x: 0, y: 0 }, theme: "dark", viewport: {} }
  nodesData  Json? // Raw visual nodes Array [{ id, type, position, data }]
  edgesData  Json? // Raw visual edges Array [{ id, source, target, label }]

  isTemplate       Boolean @default(false)
  templateCategory String?
  thumbnailUrl     String?

  currentVersionId String?
  versions         SchemaVersion[]
  comments         Comment[]
  chatMessages     ChatMessage[]
  aiSessions       AISession[]
  changeSets       ChangeSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
  @@map("diagram")
}

model SchemaVersion {
  id        String  @id @default(cuid())
  diagramId String
  diagram   Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  versionNumber Int
  versionTag    String? // e.g. "v1.0.0", "prod-release"
  commitMessage String? // e.g. "Added Users and Orders tables"

  schemaSnapshot Json    // Full snapshot of tables, columns, relations, and positions
  generatedSql   String? // Compiled SQL DDL script for this version
  diffSummary    Json?   // JSON object detailing additions, deletions, modifications vs previous version

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([diagramId, versionNumber])
  @@map("schema_version")
}

// ==========================================
// 5. Canvas Mini Chat Room & Comment Pins
// ==========================================

enum CommentTargetType {
  CANVAS        // General comment pinned on canvas X, Y coordinates
  TABLE_NODE    // Pinned to a specific table/node
  COLUMN_FIELD  // Pinned to a specific column/field inside a table
  EDGE_RELATION // Pinned to a relationship edge
}

enum CommentStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

model Comment {
  id        String  @id @default(cuid())
  diagramId String
  diagram   Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("CommentAuthor", fields: [userId], references: [id], onDelete: Cascade)

  // Canvas Pin Positioning (Floating Comment Bubble)
  targetType    CommentTargetType @default(CANVAS)
  positionX     Float?            // Canvas X coordinate for bubble pin
  positionY     Float?            // Canvas Y coordinate for bubble pin
  targetNodeId  String?           // Node ID (e.g. "table_user")
  targetFieldId String?           // Column/field ID (e.g. "email")
  targetEdgeId  String?           // Relationship Edge ID

  // Threaded Chat Room (Parent/Reply hierarchy)
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  // Content & Rich Chat Features
  content     String
  attachments Json?  // Files, code snippets, image attachments
  reactions   Json?  // Emojis: { "👍": ["user_id_1"], "❤️": ["user_id_2"] }

  // Governance & Status
  status       CommentStatus @default(OPEN)
  resolvedById String?
  resolvedBy   User?         @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  assigneeId String?
  assignee   User?   @relation("CommentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([diagramId, targetNodeId])
  @@map("comment")
}

// ==========================================
// 6. Project & Direct Message Chat Engine
// ==========================================

enum ChatRoomType {
  PROJECT_GROUP // Project-level chat group for project members
  DIRECT        // 1-on-1 personal chat between two users
  CUSTOM_GROUP  // Custom group chat for sub-teams / topics
}

enum ChatMemberRole {
  ADMIN
  MEMBER
}

enum ChatMessageType {
  TEXT
  FILE
  DIAGRAM_LINK
  SYSTEM_EVENT
}

model ChatRoom {
  id          String       @id @default(cuid())
  type        ChatRoomType @default(PROJECT_GROUP)
  name        String?      // Name for group chats (e.g. "Auth Service Project Chat")
  description String?
  avatarUrl   String?

  // Scopes & Relationships
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Direct Message Unique Key (sorted user IDs "userA:userB" for 1-on-1 room deduplication)
  dmKey String? @unique

  createdById String?
  createdBy   User?   @relation("ChatRoomCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members       ChatRoomMember[]
  messages      ChatMessage[]
  lastMessageAt DateTime         @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chat_room")
}

model ChatRoomMember {
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role       ChatMemberRole @default(MEMBER)
  lastReadAt DateTime       @default(now())
  isMuted    Boolean        @default(false)
  isPinned   Boolean        @default(false)

  joinedAt DateTime @default(now())

  @@id([chatRoomId, userId])
  @@map("chat_room_member")
}

model ChatMessage {
  id         String   @id @default(cuid())
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)

  type ChatMessageType @default(TEXT)

  content     String
  attachments Json?   // Files, images, code snippets
  diagramId   String? // Optional diagram attachment link
  diagram     Diagram? @relation(fields: [diagramId], references: [id], onDelete: SetNull)

  // Threaded Message Reply
  replyToId String?
  replyTo   ChatMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("MessageReplies")

  reactions Json?   // Emoji reactions e.g. { "👍": ["user1"] }
  isEdited  Boolean @default(false)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatRoomId, createdAt])
  @@map("chat_message")
}

// ==========================================
// 7. Action-Oriented AI Agent & ChangeSet Engine
// ==========================================

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum ChangeSetStatus {
  PENDING
  APPLIED
  REJECTED
  SUPERSEDED
  FAILED
}

model AISession {
  id          String   @id @default(cuid())
  title       String?  // Auto-generated session title (e.g. "Payment Schema Refactoring")

  diagramId   String
  diagram     Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // The session maintains the "AI's memory" & Context state
  contextSummary String?  // AI's internal summary of past turns & goal state
  aiModel        String?  // Active model (e.g. "gemini-3.7-flash", "gemini-1.5-pro")

  messages    AIMessage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ai_session")
}

model AIMessage {
  id          String    @id @default(cuid())
  sessionId   String
  session     AISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role        MessageRole @default(USER)
  content     String

  // AI Tool Calls Execution (Agentic steps)
  toolCalls   Json?     // [{ name: "propose_changeset", args: {...} }]

  // 🚀 Action Proposal Linkage: One message can propose 1 or more ChangeSets
  changeSets  ChangeSet[]

  // Tokens & Credits Consumption Tracking
  tokensUsed       Int?
  creditsDeducted  Int?     @default(1)

  // Context Tracking: At which schema version was this message sent?
  schemaVersion    Int      // The version the AI was "looking at" when it replied

  createdAt   DateTime @default(now())

  @@map("ai_message")
}

model ChangeSet {
  id                 String          @id @default(cuid())
  diagramId          String
  diagram            Diagram         @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  baseVersionNumber  Int             // Base version when proposed (Stale Proposal detection)
  resultingVersionNo Int?            // New SchemaVersion created when applied
  status             ChangeSetStatus @default(PENDING)

  // The actual mutation payload: { addTables: [], removeTables: [], modifyColumns: [], addEdges: [] }
  changes            Json
  reasoning          String?         // AI's explanation: "Why I'm making these architectural changes"

  // Link back to the AI Chat Message that generated this proposal
  aiMessageId        String?
  aiMessage          AIMessage?      @relation(fields: [aiMessageId], references: [id], onDelete: SetNull)

  // User Review & Governance
  appliedById        String?
  appliedBy          User?           @relation("ChangeSetApplier", fields: [appliedById], references: [id], onDelete: SetNull)

  appliedAt          DateTime?

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("change_set")
}

// ==========================================
// 8. Fine-Grained RBAC (Roles & Permissions)
// ==========================================

enum RoleScope {
  SYSTEM       // Platform Staff Roles (SuperAdmin, Support, Moderator, Billing)
  ORGANIZATION // Customer Org Roles (Owner, Admin, Member)
  PROJECT      // Customer Project Roles (Admin, Editor, Viewer)
}

model Role {
  id          String    @id @default(cuid())
  name        String
  description String?
  scope       RoleScope
  isSystem    Boolean   @default(false)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  permissions         RolePermission[]
  organizationMembers OrganizationMember[]
  projectMembers      ProjectMember[]
  invitations         Invitation[]
  systemUsers         User[]               @relation("SystemStaffRole")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("role")
}

model Permission {
  id          String  @id @default(cuid())
  resource    String // e.g. "platform", "organization", "project", "graph", "user", "billing"
  action      String // e.g. "create", "read", "update", "delete", "manage", "ban", "export"
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())

  @@unique([resource, action])
  @@map("permission")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@map("role_permission")
}

// ==========================================
// 9. Subscription, Plans & Explicit Feature Quota Layer
// ==========================================

enum PlanTier {
  FREE
  PRO
  TEAM
  ENTERPRISE
  CUSTOM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plan   PlanTier           @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  // Payment gateway identifiers (Stripe, LemonSqueezy, Polar, Razorpay)
  customerId     String?
  subscriptionId String?
  priceId        String?

  // Billing cycle timestamps
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  // ==========================================
  // Explicit Feature Columns (1-to-1 from plans.md)
  // ==========================================

  // 1. Core Quotas & Limits
  maxProjects      Int      @default(3) // Projects (3, -1=Unlimited)
  maxTeamMembers   Int      @default(1) // Team members (1, 20, -1=Custom)
  monthlyAiCredits Int      @default(50) // AI credits (50, 2000, 5000, -1=Custom)
  usedAiCredits    Int      @default(0) // Current cycle usage
  creditsResetAt   DateTime @default(now())

  // 2. AI Capabilities & Controls
  hasAiSchemaGeneration Boolean @default(true) // AI Schema Generation (✅)
  aiSchemaReviewLevel   String  @default("BASIC") // AI Schema Review ("BASIC", "ADVANCED")
  aiSqlAssistantLevel   String  @default("LIMITED") // AI SQL Assistant ("LIMITED", "FULL")
  aiMigrationLevel      String  @default("LIMITED") // AI Migration ("LIMITED", "FULL")

  // 3. Diagramming & Modeling Limits
  databaseTypesLevel     String  @default("LIMITED") // Database types ("LIMITED"=2-3, "ALL")
  hasVisualErd           Boolean @default(true) // Visual ERD (✅)
  maxDiagramsPerProject  Int     @default(1) // Multiple diagrams/Project (1, -1=Unlimited)
  maxSchemaVersions      Int     @default(5) // Schema versions (5, -1=Unlimited)
  schemaDiffLevel        String  @default("BASIC") // Schema diff ("BASIC", "ADVANCED")

  // 4. Import & Export Entitlements
  hasSqlImport        Boolean @default(true) // SQL Import (✅)
  sqlExportLevel      String  @default("BASIC") // SQL Export ("BASIC", "ADVANCED")
  prismaExportLevel   String  @default("LIMITED") // Prisma Export ("LIMITED", "FULL")
  drizzleExportLevel  String  @default("LIMITED") // Drizzle Export ("LIMITED", "FULL")
  hasMongooseExport   Boolean @default(false) // Mongoose Export (❌/✅)
  dbmlMermaidLevel    String  @default("BASIC") // DBML / Mermaid ("BASIC", "FULL")
  pngSvgExportLevel   String  @default("LIMITED") // PNG/SVG Export ("LIMITED", "FULL")
  hasPdfDocumentation Boolean @default(false) // PDF Documentation (❌/✅)

  // 5. Database Connection & Reverse Engineering
  maxLiveDbConnections   Int     @default(0) // Live DB Connection (0, 5, 20, -1=Custom)
  hasReverseEngineering  Boolean @default(false) // Reverse Engineering (❌/✅)
  dbCredentialsLevel     String  @default("NONE") // Database Credentials ("NONE", "ENCRYPTED", "ADVANCED")
  mockDataGeneratorLevel String  @default("LIMITED") // Mock Data Generator ("LIMITED", "FULL", "CUSTOM")
  templatesLevel         String  @default("BASIC") // Templates ("BASIC", "ALL")

  // 6. Storage & Payload Limits
  maxStorageMb     Int    @default(100) // File Storage (100MB, 5GB, 50GB, -1)
  usedStorageBytes BigInt @default(0) // Current storage consumption
  maxFileImportMb  Int    @default(5) // File Import Size (5MB, 100MB, 500MB, -1)

  // 7. Collaboration & Governance
  hasCollaboration      Boolean @default(false) // Collaboration (❌/✅)
  hasComments           Boolean @default(false) // Comments (❌/✅)
  hasSharedProject      Boolean @default(false) // Shared Project (❌/✅)
  rbacLevel             String  @default("NONE") // RBAC ("NONE", "FULL", "ADVANCED")
  auditLogRetentionDays Int     @default(0) // Audit Logs (0, 30, -1=Unlimited)

  // 8. Integrations & Developer Tools
  githubIntegrationLevel String  @default("NONE") // GitHub Integration ("NONE", "FULL", "ENTERPRISE")
  webhooksLevel          String  @default("NONE") // Webhooks ("NONE", "LIMITED", "FULL", "CUSTOM")
  apiAccessLevel         String  @default("NONE") // API Access ("NONE", "LIMITED", "FULL", "UNLIMITED")
  hasCliAccess           Boolean @default(false) // CLI (❌/✅)
  hasVsCodeExtension     Boolean @default(false) // VS Code Extension (❌/✅)
  mcpAccessLevel         String  @default("NONE") // MCP ("NONE", "LIMITED", "FULL")

  // 9. Enterprise & Security Controls
  hasSso              Boolean @default(false) // SSO (❌/✅)
  hasScim             Boolean @default(false) // SCIM (❌/✅)
  hasIpAllowlist      Boolean @default(false) // IP Allowlist (❌/✅)
  hasAdvancedSecurity Boolean @default(false) // Advanced Security (❌/✅)
  hasDedicatedInfra   Boolean @default(false) // Dedicated Infrastructure (❌/✅)
  slaLevel            String  @default("NONE") // SLA ("NONE", "CUSTOM")
  supportTier         String  @default("COMMUNITY") // Support ("COMMUNITY", "EMAIL", "PRIORITY", "DEDICATED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String // e.g. "project.create", "member.invite", "schema.export"
  entityType String // e.g. "PROJECT", "MEMBER", "ROLE", "SCHEMA", "BILLING"
  entityId   String?
  details    String? // JSON string of payload, changes, or diffs
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

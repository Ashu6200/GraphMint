# ==========================================
# GraphMint - Root Environment Template
# Copy this file to .env and adjust values
# ==========================================

# Environment & Logging
NODE_ENV=development
LOG_LEVEL=info

# Service Ports
GATEWAY_PORT=3000
CORE_SERVICE_PORT=3001
AI_SERVICE_PORT=3002
IMPORT_EXPORT_SERVICE_PORT=3003
PLATFORM_SERVICE_PORT=3004

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Gateway Upstream Service URLs
CORE_SERVICE_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:3002
IMPORT_EXPORT_SERVICE_URL=http://localhost:3003
PLATFORM_SERVICE_URL=http://localhost:3004

# Database (Prisma Postgres Connection String)
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=your_api_key_here"
